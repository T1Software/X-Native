<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>XNative.App</RootNamespace>
    <AssemblyName>XNative.App</AssemblyName>
    <Description>Composition root for X-Native. Wires the modules together through dependency injection. A UWP application head will be added as a separate project later.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XNative.Core\XNative.Core.csproj" />
    <ProjectReference Include="..\XNative.Graphics\XNative.Graphics.csproj" />
    <ProjectReference Include="..\XNative.Platform\XNative.Platform.csproj" />
    <ProjectReference Include="..\XNative.Plugins\XNative.Plugins.csproj" />
    <ProjectReference Include="..\XNative.UI\XNative.UI.csproj" />
    <ProjectReference Include="..\XNative.Wine\XNative.Wine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

</Project>
