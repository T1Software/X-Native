<Page
    x:Class="XNative.XboxHost.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:XNative.UI.ViewModels"
    mc:Ignorable="d"
    Background="#FF101014">

    <!-- The outer margin keeps the content inside the title safe area of a television. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="96,54,96,54">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Left">

            <TextBlock
                Text="X-Native"
                FontSize="72"
                FontWeight="SemiLight"
                Foreground="#FFF2F2F2" />

            <TextBlock
                x:Name="VersionText"
                FontSize="18"
                Foreground="#FF8A8A93"
                Margin="0,4,0,0" />

            <ItemsControl
                x:Name="ModulesList"
                Margin="0,40,0,0"
                ItemsSource="{x:Bind ViewModel.Modules, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ModuleStatusViewModel">
                        <TextBlock
                            Text="{x:Bind Line, Mode=OneWay}"
                            FontSize="28"
                            FontFamily="Consolas"
                            Margin="0,0,0,10"
                            Foreground="#FF6FD08C" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Text="Device information:"
                FontSize="28"
                Margin="0,40,0,12"
                Foreground="#FFF2F2F2" />

            <TextBlock
                Text="{x:Bind ViewModel.DeviceInfoText, Mode=OneWay}"
                FontSize="22"
                FontFamily="Consolas"
                LineHeight="34"
                Foreground="#FFB8B8C0" />

            <!-- Game Library Section -->
            <TextBlock
                Text="Game Library"
                FontSize="36"
                FontWeight="SemiLight"
                Margin="0,48,0,16"
                Foreground="#FFF2F2F2" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button
                    Content="Scan Games"
                    Command="{x:Bind GameLibrary.ScanGamesCommand, Mode=OneWay}"
                    FontSize="20"
                    Padding="24,12"
                    Background="#FF2D2D30"
                    Foreground="#FFF2F2F2"
                    BorderBrush="#FF3E3E42"
                    BorderThickness="1"
                    MinWidth="180" />
                <TextBlock
                    Text="{x:Bind GameLibrary.ScanStatus, Mode=OneWay}"
                    FontSize="20"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0"
                    Foreground="#FF8A8A93" />
            </StackPanel>

            <TextBlock
                Text="{x:Bind GameLibrary.GamesFoundText, Mode=OneWay}"
                FontSize="20"
                Margin="0,8,0,16"
                Foreground="#FF6FD08C" />

            <ItemsControl
                x:Name="GamesList"
                ItemsSource="{x:Bind GameLibrary.Games, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:GameViewModel">
                        <Border
                            Background="#FF1E1E22"
                            BorderBrush="#FF3E3E42"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="16"
                            Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Text="✓ "
                                        FontSize="22"
                                        Foreground="#FF6FD08C"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="{x:Bind Name, Mode=OneWay}"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="#FFF2F2F2"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="  "
                                        FontSize="24"
                                        VerticalAlignment="Center" />
                                    <Border
                                        Background="#FF2D2D30"
                                        BorderBrush="#FF3E3E42"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Padding="8,2"
                                        Margin="8,0,0,0">
                                        <TextBlock
                                            Text="{x:Bind Runner, Mode=OneWay}"
                                            FontSize="16"
                                            FontFamily="Consolas"
                                            Foreground="#FF8A8A93"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Text="{x:Bind ExecutablePath, Mode=OneWay}"
                                    FontSize="16"
                                    FontFamily="Consolas"
                                    Foreground="#FF8A8A93"
                                    Margin="28,4,0,0"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                x:Name="ErrorText"
                FontSize="20"
                Margin="0,32,0,0"
                TextWrapping="Wrap"
                Visibility="Collapsed"
                Foreground="#FFE06C75" />

        </StackPanel>
    </ScrollViewer>
</Page>